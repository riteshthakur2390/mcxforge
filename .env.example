# =============================================================================
# MCXForge Environment Configuration
# =============================================================================

# Application Identity
APP_NAME=MCXForge
INSTRUMENT=SILVERMIC
COMMODITY=SILVERMIC
TRADING_MODE=OBSERVE  # OBSERVE (Paper trading/logging), MANUAL, AUTO, BACKTEST
DASHBOARD_PORT=5054
LOG_LEVEL=INFO

# Broker Selection (dhan, upstox, kite, groww, yfinance)
BROKER=dhan

# Dhan HQ Credentials (default for MCXForge — 5-year historical data)
# Get from https://web.dhan.co -> My Profile -> Apps -> Generate Token
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Upstox API Credentials (optional)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5000/callback
UPSTOX_ACCESS_TOKEN=

# Zerodha Kite Credentials (optional)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Market Timing (IST)
SYSTEM_START_TIME=08:45
MARKET_OPEN_TIME=09:00
SIGNAL_START_TIME=09:30
NO_NEW_SIGNAL_AFTER=23:00
EOD_SQUARE_OFF_TIME=23:15
MARKET_CLOSE_TIME=23:30

# Capital & Risk Management
PAPER_TRADING_CAPITAL=100000
MAX_DRAWDOWN_LIMIT_PCT=5.0
RISK_BUDGET_PER_TRADE_PCT=2.0

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LIVE_TELEGRAM_BOT_TOKEN=
LIVE_TELEGRAM_CHAT_ID=
BACKTEST_TELEGRAM_BOT_TOKEN=
BACKTEST_TELEGRAM_CHAT_ID=
